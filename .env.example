# Copia questo file in ".env" e adatta i valori.
# Con Docker Compose non serve: le variabili sono già impostate in docker-compose.yml.

# Indirizzo del database PostgreSQL
DATABASE_URL=postgres://gdr:gdr@localhost:5432/gdr

# Indirizzo pubblico del sito (obbligatorio in produzione per la protezione dei form)
ORIGIN=http://localhost:3000

# Password del database usata da Docker Compose (se manca vale "gdr"). Solo lettere e numeri.
# Va scelta PRIMA del primo avvio sul server: vedi docs/guida-staff.md → "Mettere il gioco online".
# DB_PASSWORD=scegli-una-password-lunga

# Solo in produzione dietro un server web (Caddy, Nginx...): vero indirizzo dei giocatori.
# Senza queste due righe i limiti sui tentativi di accesso valgono per tutti insieme.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
