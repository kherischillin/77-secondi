# Copia questo file in ".env" e adatta i valori.
# Con Docker Compose non serve: le variabili sono già impostate in docker-compose.yml.

# Indirizzo del database PostgreSQL
DATABASE_URL=postgres://gdr:gdr@localhost:5432/gdr

# Indirizzo pubblico del sito (obbligatorio in produzione per la protezione dei form)
ORIGIN=http://localhost:3000
